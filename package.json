    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "latest",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "latest",
    "react-is": "^19.2.6",
    "recharts": "latest",
    "sonner": "latest",
