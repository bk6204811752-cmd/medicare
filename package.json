{
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "postinstall": "node scripts/postinstall.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:azure:generate": "prisma generate --schema prisma/schema.azure.prisma",
    "db:azure:push": "node scripts/setup-azure-sql.js",
    "db:azure:seed": "node prisma/seed-azure.js",
    "db:azure:setup": "node scripts/setup-azure-sql.js && prisma generate --schema prisma/schema.azure.prisma && node prisma/seed-azure.js"
  },
  "dependencies": {
