# Local Prisma dev database.
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"

# Azure SQL Database. Set DATABASE_PROVIDER="sqlserver" after generating with prisma/schema.azure.prisma.
AZURE_SQL_SERVER="basant-server.database.windows.net"
AZURE_SQL_DATABASE="myfree-db"
AZURE_DATABASE_URL="sqlserver://basant-server.database.windows.net:1433;database=myfree-db;encrypt=true;trustServerCertificate=false;connectionTimeout=30;authentication=DefaultAzureCredential"

ADMIN_EMAIL="admin@medcare.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MedCare <no-reply@medcare.local>"
DAILY_REPORT_SECRET="change-this-secret"
