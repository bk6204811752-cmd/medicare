generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  ownerName       String?
  phone           String
  email           String?
  city            String?
  state           String?
  address         String?
  gstin           String?
  drugLicenseNo   String?
  upiId           String?
  profilePicUrl   String?
  plan            String              @default("free")
  isActive        Boolean             @default(true)
  approvalStatus  String              @default("approved")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  customers       Customer[]
  inventory       InventoryItem[]
  sales           Sale[]
  scheduleHItems  ScheduleHRegister[]
  stockMovements  StockMovement[]
  suppliers       Supplier[]
  users           User[]
  reportLogs      DailyReportLog[]
  purchaseOrders  PurchaseOrder[]
  saleReturns     SaleReturn[]
  purchaseReturns PurchaseReturn[]
  prescriptionImages PrescriptionImage[]
  parties         Party[]
  routes          Route[]
  salesmen        Salesman[]
  b2bSalesOrders       B2BSalesOrder[]
  b2bSales             B2BSale[]
  receipts             Receipt[]
  b2bIndents           B2BIndent[]
  chemistOrders        StockistOrder[]     @relation("ChemistOrders")
  receivedOrders       StockistOrder[]     @relation("StockistReceivedOrders")
  inAppNotifications   InAppNotification[]
}

model User {
  id            String        @id @default(cuid())
  tenantId      String?
  name          String
  email         String        @unique
  phone         String?
  passwordHash  String
  role          String        @default("shop_admin")
  isActive      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  tenant        Tenant?       @relation(fields: [tenantId], references: [id])
  sessions      AuthSession[]
  resetOtps     PasswordResetOtp[]

  @@index([tenantId])
  @@index([email])
}

model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationOtp {
  id        String    @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model DailyReportLog {
  id         String   @id @default(cuid())
  tenantId   String
  reportDate String
  sentTo     String
  sentAt     DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Medicine {
  id                   String          @id @default(cuid())
  name                 String
  genericName          String?
  manufacturer         String?
  category             String?
  composition          String?
  dosageForm           String?
  strength             String?
  packSize             String?
  hsnCode              String?
  gstRate              Int      @default(12)
  mrpPaisa             Int
  ptrPaisa             Int      @default(0)
  ptsPaisa             Int      @default(0)
  specialRatePaisa     Int      @default(0)
  schedule             String   @default("OTC")
  barcode              String?
  requiresPrescription Boolean  @default(false)
  createdAt            DateTime        @default(now())
  inventory            InventoryItem[]

  @@index([name])
  @@index([genericName])
  @@index([barcode])
}

model InventoryItem {
  id                  String               @id @default(cuid())
  tenantId            String
  medicineId          String
  batchNo             String
  mfgDate             DateTime?
  expiryDate          DateTime
  purchaseRatePaisa   Int
  mrpPaisa            Int
  saleRatePaisa       Int
  gstRate             Int
  hsnCode             String?
  quantity            Int      @default(0)
  reorderLevel        Int      @default(10)
  rackLocation        String?
  supplierId          String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  medicine            Medicine   @relation(fields: [medicineId], references: [id])
  saleItems           SaleItem[]
  stockMovements      StockMovement[]
  supplier            Supplier?  @relation(fields: [supplierId], references: [id])
  tenant              Tenant     @relation(fields: [tenantId], references: [id])
  purchaseItems       PurchaseOrderItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  ptrPaisa            Int      @default(0)
  ptsPaisa            Int      @default(0)
  specialRatePaisa    Int      @default(0)
  b2bSaleItems        B2BSaleItem[]

  @@index([tenantId])
  @@index([medicineId])
  @@index([supplierId])
  @@unique([tenantId, medicineId, batchNo])
}

model Supplier {
  id              String            @id @default(cuid())
  tenantId        String
  name            String
  phone           String?
  email           String?
  address         String?
  gstin           String?
  creditDays      Int             @default(30)
  balancePaisa    Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  inventory       InventoryItem[]
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@index([tenantId])
}

model Customer {
  id               String       @id @default(cuid())
  tenantId         String
  name             String
  phone            String?
  email            String?
  address          String?
  doctorName       String?
  outstandingPaisa Int      @default(0)
  loyaltyPoints    Int      @default(0)
  createdAt        DateTime @default(now())
  sales            Sale[]
  saleReturns      SaleReturn[]
  tenant           Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([phone])
}

model Sale {
  id              String     @id @default(cuid())
  tenantId        String
  invoiceNo       String     @unique
  invoiceDate     DateTime   @default(now())
  customerId      String?
  customerName    String?
  customerPhone   String?
  prescriptionNo  String?
  doctorName      String?
  paymentMode     String     @default("cash")
  subtotalPaisa   Int
  discountPaisa   Int        @default(0)
  taxablePaisa    Int
  cgstPaisa       Int        @default(0)
  sgstPaisa       Int        @default(0)
  igstPaisa       Int        @default(0)
  gstPaisa        Int
  roundOffPaisa   Int        @default(0)
  totalPaisa      Int
  amountPaidPaisa Int        @default(0)
  amountDuePaisa  Int        @default(0)
  status          String     @default("completed")
  createdAt       DateTime   @default(now())
  customer        Customer?  @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  saleReturns     SaleReturn[]
  prescriptionImages PrescriptionImage[]

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, createdAt])
}

model SaleItem {
  id              String             @id @default(cuid())
  saleId          String
  tenantId        String
  inventoryId     String
  medicineName    String
  batchNo         String
  expiryDate      DateTime
  quantity        Int
  mrpPaisa        Int
  saleRatePaisa   Int
  discountPercent Int                @default(0)
  discountPaisa   Int                @default(0)
  hsnCode         String?
  gstRate         Int
  gstPaisa        Int
  cgstPaisa       Int                @default(0)
  sgstPaisa       Int                @default(0)
  igstPaisa       Int                @default(0)
  taxablePaisa    Int
  totalPaisa      Int
  schedule        String             @default("OTC")
  inventory       InventoryItem      @relation(fields: [inventoryId], references: [id])
  sale            Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  scheduleHEntry  ScheduleHRegister?
  saleReturnItems SaleReturnItem[]

  @@index([saleId])
  @@index([tenantId])
  @@index([inventoryId])
}

model ScheduleHRegister {
  id             String   @id @default(cuid())
  tenantId       String
  saleItemId     String   @unique
  medicineName   String
  quantity       Int
  customerName   String?
  customerPhone  String?
  doctorName     String?
  prescriptionNo String?
  saleDate       DateTime @default(now())
  saleItem       SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model StockMovement {
  id             String        @id @default(cuid())
  tenantId       String
  inventoryId    String
  adjustmentType String
  quantityDelta  Int
  reason         String
  referenceNo    String?
  notes          String?
  createdAt      DateTime      @default(now())
  inventory      InventoryItem @relation(fields: [inventoryId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([inventoryId])
}

// ─── Purchase Orders ────────────────────────────────────────

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String
  poNumber     String              @unique
  supplierId   String
  status       String              @default("draft")
  totalPaisa   Int                 @default(0)
  notes        String?
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]

  @@index([tenantId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  inventoryId      String?
  medicineName     String
  quantity         Int
  receivedQuantity Int            @default(0)
  ratePaisa        Int
  totalPaisa       Int
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventory        InventoryItem? @relation(fields: [inventoryId], references: [id])

  @@index([purchaseOrderId])
}

// ─── Sale Returns ───────────────────────────────────────────

model SaleReturn {
  id          String           @id @default(cuid())
  tenantId    String
  returnNo    String           @unique
  saleId      String
  customerId  String?
  reason      String
  refundPaisa Int              @default(0)
  status      String           @default("completed")
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id])
  customer    Customer?        @relation(fields: [customerId], references: [id])
  items       SaleReturnItem[]

  @@index([tenantId])
  @@index([saleId])
}

model SaleReturnItem {
  id           String        @id @default(cuid())
  saleReturnId String
  saleItemId   String
  inventoryId  String
  medicineName String
  batchNo      String
  quantity     Int
  refundPaisa  Int
  saleReturn   SaleReturn    @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem      @relation(fields: [saleItemId], references: [id])
  inventory    InventoryItem @relation(fields: [inventoryId], references: [id])

  @@index([saleReturnId])
}

// ─── Purchase Returns ───────────────────────────────────────

model PurchaseReturn {
  id         String               @id @default(cuid())
  tenantId   String
  returnNo   String               @unique
  supplierId String
  reason     String
  totalPaisa Int                  @default(0)
  status     String               @default("completed")
  createdAt  DateTime             @default(now())
  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  supplier   Supplier             @relation(fields: [supplierId], references: [id])
  items      PurchaseReturnItem[]

  @@index([tenantId])
  @@index([supplierId])
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  inventoryId      String
  medicineName     String
  batchNo          String
  quantity         Int
  ratePaisa        Int
  totalPaisa       Int
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  inventory        InventoryItem  @relation(fields: [inventoryId], references: [id])

  @@index([purchaseReturnId])
}

// ─── Prescription Images ────────────────────────────────────

model PrescriptionImage {
  id           String   @id @default(cuid())
  tenantId     String
  saleId       String?
  imageUrl     String
  doctorName   String?
  patientName  String?
  notes        String?
  uploadedAt   DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sale         Sale?    @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([saleId])
}

// ─── Wholesaler / Stockist B2B Models ─────────────────────────

model Route {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  parties     Party[]
  salesmen    SalesmanRoute[]

  @@index([tenantId])
}

model Salesman {
  id                String          @id @default(cuid())
  tenantId          String
  name              String
  phone             String?
  email             String?
  targetPaisa       Int             @default(0)
  commissionPercent Float           @default(0.0)
  commissionOn      String          @default("sales") // "sales" or "collection"
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  routes            SalesmanRoute[]
  salesOrders       B2BSalesOrder[]
  receipts          Receipt[]

  @@index([tenantId])
}

model SalesmanRoute {
  salesmanId String
  routeId    String
  salesman   Salesman @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([salesmanId, routeId])
}

model Party {
  id               String          @id @default(cuid())
  tenantId         String
  name             String
  phone            String?
  email            String?
  address          String?
  gstin            String?
  drugLicenseNo    String?
  creditLimitPaisa Int             @default(0)
  outstandingPaisa Int             @default(0)
  routeId          String?
  createdAt        DateTime        @default(now())
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  route            Route?          @relation(fields: [routeId], references: [id])
  salesOrders      B2BSalesOrder[]
  b2bSales         B2BSale[]
  receipts         Receipt[]

  @@index([tenantId])
}

model B2BSalesOrder {
  id            String             @id @default(cuid())
  tenantId      String
  orderNo       String             @unique
  orderDate     DateTime           @default(now())
  partyId       String
  salesmanId    String?
  status        String             @default("pending") // "pending", "billed", "cancelled"
  subtotalPaisa Int
  discountPaisa Int                @default(0)
  taxablePaisa  Int
  gstPaisa      Int
  totalPaisa    Int
  notes         String?
  createdAt     DateTime           @default(now())
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  party         Party              @relation(fields: [partyId], references: [id])
  salesman      Salesman?          @relation(fields: [salesmanId], references: [id])
  items         B2BSalesOrderItem[]
  b2bSales      B2BSale[]

  @@index([tenantId])
}

model B2BSalesOrderItem {
  id           String        @id @default(cuid())
  orderId      String
  medicineId   String
  medicineName String
  quantity     Int
  freeQuantity Int           @default(0)
  ratePaisa    Int
  totalPaisa   Int
  order        B2BSalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model B2BSale {
  id              String        @id @default(cuid())
  tenantId        String
  invoiceNo       String        @unique
  invoiceDate     DateTime      @default(now())
  partyId         String
  salesmanId      String?
  orderId         String?
  paymentMode     String        @default("credit") // "credit", "cash", "upi", "cheque"
  subtotalPaisa   Int
  discountPaisa   Int           @default(0)
  taxablePaisa    Int
  gstPaisa        Int
  roundOffPaisa   Int           @default(0)
  totalPaisa      Int
  amountPaidPaisa Int           @default(0)
  amountDuePaisa  Int           @default(0)
  status          String        @default("unpaid") // "unpaid", "paid", "partial"
  invoiceType     String        @default("invoice") // "invoice" | "challan"
  notes           String?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  party           Party         @relation(fields: [partyId], references: [id])
  order           B2BSalesOrder? @relation(fields: [orderId], references: [id])
  items           B2BSaleItem[]

  @@index([tenantId])
  @@index([tenantId, invoiceDate])
}

model B2BSaleItem {
  id              String        @id @default(cuid())
  saleId          String
  inventoryId     String
  medicineName    String
  batchNo         String
  expiryDate      DateTime
  quantity        Int
  freeQuantity    Int           @default(0)
  mrpPaisa        Int
  saleRatePaisa   Int
  discountPercent Int           @default(0)
  gstRate         Int
  gstPaisa        Int
  taxablePaisa    Int
  totalPaisa      Int
  schemeDetails   String?
  sale            B2BSale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id])

  @@index([saleId])
}

model Receipt {
  id          String    @id @default(cuid())
  tenantId    String
  partyId     String
  salesmanId  String?
  receiptNo   String    @unique
  receiptDate DateTime  @default(now())
  amountPaisa Int
  paymentMode String    // "cash", "cheque", "upi", "neft"
  referenceNo String?
  notes       String?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  party       Party     @relation(fields: [partyId], references: [id])
  salesman    Salesman? @relation(fields: [salesmanId], references: [id])

  @@index([tenantId])
  @@index([tenantId, receiptDate])
}

model B2BIndent {
  id           String           @id @default(cuid())
  tenantId     String
  indentNo     String           @unique
  indentDate   DateTime         @default(now())
  chemistName  String
  phone        String?
  status       String           @default("pending") // "pending", "processed", "cancelled"
  totalPaisa   Int              @default(0)
  createdAt    DateTime         @default(now())
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  items        B2BIndentItem[]

  @@index([tenantId])
}

model B2BIndentItem {
  id           String    @id @default(cuid())
  indentId     String
  medicineName String
  quantity     Int
  indent       B2BIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@index([indentId])
}

// ─── Chemist ↔ Stockist Integration ─────────────────────────────

model StockistOrder {
  id                 String               @id @default(cuid())
  orderNo            String               @unique
  chemistTenantId    String
  stockistTenantId   String
  chemistName        String
  chemistPhone       String?
  status             String               @default("pending")
  // status: "pending" | "accepted" | "otp_sent" | "delivered" | "cancelled"
  notes              String?
  totalPaisa         Int                  @default(0)
  orderDate          DateTime             @default(now())
  otp                String?
  otpExpiresAt       DateTime?
  otpVerifiedAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  chemistTenant      Tenant               @relation("ChemistOrders", fields: [chemistTenantId], references: [id])
  stockistTenant     Tenant               @relation("StockistReceivedOrders", fields: [stockistTenantId], references: [id])
  items              StockistOrderItem[]

  @@index([chemistTenantId])
  @@index([stockistTenantId])
  @@index([chemistTenantId, status])
  @@index([stockistTenantId, status])
}

model StockistOrderItem {
  id           String        @id @default(cuid())
  orderId      String
  medicineName String
  quantity     Int
  ratePaisa    Int           @default(0)
  batchNo      String?
  totalPaisa   Int           @default(0)
  order        StockistOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model InAppNotification {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  // type: "stockist_order_placed" | "order_accepted" | "order_rejected" | "otp_ready" | "purchase_auto_created"
  title     String
  message   String
  payload   String?  // JSON string for extra data (OTP, PO number, orderId, etc.)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, isRead])
  @@index([tenantId, createdAt])
}

